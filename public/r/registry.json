{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "ui-kit",
  "homepage": "https://github.com/SpdrMrph/ui-kit",
  "items": [
    {
      "name": "button",
      "title": "Button",
      "description": "A customizable button component with variants, sizes.",
      "dependencies": [
        "tailwind-variants"
      ],
      "files": [
        {
          "path": "src/shared/ui/Button/Button.tsx",
          "type": "registry:ui"
        },
        {
          "path": "src/shared/ui/Button/button.types.ts",
          "type": "registry:ui"
        },
        {
          "path": "src/shared/ui/Button/button.variants.ts",
          "type": "registry:ui"
        },
        {
          "path": "src/shared/ui/Button/index.ts",
          "type": "registry:ui"
        }
      ],
      "type": "registry:ui"
    },
    {
      "name": "ripple-button",
      "title": "Ripple Button",
      "description": "A customizable button component with variants, sizes, and ripple effect.",
      "dependencies": [
        "tailwind-variants"
      ],
      "registryDependencies": [
        "button"
      ],
      "files": [
        {
          "path": "src/shared/ui/RippleButton/RippleButton.tsx",
          "type": "registry:ui"
        },
        {
          "path": "src/shared/ui/RippleButton/index.ts",
          "type": "registry:ui"
        },
        {
          "path": "src/shared/ui/RippleButton/useRipple.tsx",
          "type": "registry:hook"
        }
      ],
      "cssVars": {
        "theme": {
          "animate-ripple": "ripple 600ms ease-out"
        }
      },
      "css": {
        "@keyframes ripple": {
          "to": {
            "transform": "scale(1)",
            "opacity": "0"
          }
        }
      },
      "type": "registry:ui"
    }
  ]
}